# ---------------------------------------------------------------------------
# Chicago Electric Piano — Mission Control v2
#
# On Beachhead these are set as GLOBAL env vars in the dashboard (no Target
# Service), because docker-compose.yml references them with ${VAR} substitution.
# A targeted-only var resolves to empty string in compose.
# ---------------------------------------------------------------------------

# --- Required ---------------------------------------------------------------
DB_PASSWORD=change-me-in-beachhead
JWT_SECRET=change-me-long-random-string

# First-run admin account. Created by the seeder only if no employees exist.
SEED_ADMIN_EMAIL=will@chicagoelectricpiano.com
SEED_ADMIN_PASSWORD=change-me-on-first-login

# --- File storage -----------------------------------------------------------
# "local"  -> container volume at STORAGE_LOCAL_DIR (dev / pre-GCS)
# "gcs"    -> Google Cloud Storage, signed-URL direct upload (production)
STORAGE_DRIVER=local
PUBLIC_BASE_URL=https://missioncontrol.chicagoelectricpiano.com

# Only needed when STORAGE_DRIVER=gcs. See NOTES.md "Hooking up GCS".
GCS_BUCKET_NAME=
GCS_PROJECT_ID=
# Full service-account JSON key, single line. Omit entirely if the Beachhead
# host is a GCE VM using Workload Identity / attached service account.
GCS_SERVICE_ACCOUNT_KEY=

# --- Phase 2 integrations (read but unused in Phase 1) ----------------------
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_ADMIN_API_TOKEN=
SHOPIFY_API_SCOPES=read_orders,read_fulfillments,write_fulfillments,read_products,read_inventory,read_customers
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
